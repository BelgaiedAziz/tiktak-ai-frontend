# ─── Configuration template ───────────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# !! NEVER commit .env to git !!

# Backend API base URL
REACT_APP_API_BASE_URL=http://localhost:8000

# Meta / Facebook API URL
REACT_APP_META_API_URL=http://localhost:8000

# App name
REACT_APP_NAME=TikTak AI

# Shop identifier (visible to the public, not a secret)
REACT_APP_SHOP_ID=your_shop_id_here

# Shop API token — KEEP SECRET
# Obtain from Django admin: /admin/ → TikTakToken
REACT_APP_SHOP_TOKEN=your_shop_token_here
