# ---------------------------------------------------------------------------
# TikTak AI — Frontend environment variables
# Copy this file to .env.local for local overrides (not committed to git).
# All variables MUST be prefixed with REACT_APP_ to be exposed to the app.
# ---------------------------------------------------------------------------

# Backend API
REACT_APP_CRM_API_URL=http://localhost/api/v1/crm
REACT_APP_META_API_URL=http://localhost/api/v1/gateway/messenger/poc

# Shop / tenant identifier
REACT_APP_SHOP_ID=1LXybpj

# App meta
REACT_APP_NAME=TikTak AI
